<Project Sdk="Microsoft.NET.Sdk">

  <!-- Based on the `pac plugin init` template. Registered as a classic, signed plug-in assembly
       (no dependent assemblies), so the Microsoft.PowerApps.MSBuild.Plugin package step is not used. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>UgWorkshop.Plugins.snk</AssemblyOriginatorKeyFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>DynUG workshop</Authors>
    <Description>Event Check-in registration rules plug-in for the DynUG agent-assisted Power Platform workshop.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />
  </ItemGroup>

</Project>
